EXHAUSTIVE CAYLEY-GRAPH CODE CLASSIFICATION FOR ALL 15 GROUPS OF ORDER 24
========================================================================

For i=1,...,15, let G_i = SmallGroup(24,i) in GAP.
For every inverse-closed D subset G\{e}, construct A_D for Cay(G,D) and
C_D = Row_F2(A_D).

Computes, for each group:
  * t(G), p(G), N(G)=2^(t+p)
  * complete rank distribution N_G(k)
  * exact best distance d_G(k) for every attainable k
  * representative D attaining each d_G(k)
  * all rank-12 self-dual cases (A_D^2=0), Type I/II, and distance
  * optionally full N_G(k,d) for every connection set (much slower)

Requirements:
  * Python 3.9+
  * GAP installed and callable as `gap`
  * no third-party Python package

Examples:
  python cayley_codes_all_15_groups_order24.py --group 12
  python cayley_codes_all_15_groups_order24.py --all
  python cayley_codes_all_15_groups_order24.py --group 3 --out results24

The program is resumable: rerun the same command after interruption.
"""

from __future__ import annotations
import argparse, csv, json, math, os, shutil, subprocess, tempfile, time
from collections import defaultdict
from itertools import combinations
from pathlib import Path

GROUP_NAMES = {
    1:  "C3 : C8",
    2:  "C24",
    3:  "SL(2,3)",
    4:  "Dic6",
    5:  "C4 x S3",
    6:  "D12 (order 24)",
    7:  "C2 x Dic3",
    8:  "C3 : D4",
    9:  "C2 x C12",
    10: "C3 x D4",
    11: "C3 x Q8",
    12: "S4",
    13: "C2 x A4",
    14: "C2^2 x S3",
    15: "C2^2 x C6",
}
N = 24

# ---------------------------------------------------------------------
# GAP bridge
# ---------------------------------------------------------------------
def get_group_data_from_gap(group_id, gap_command="gap", cache_dir=None):
    if not 1 <= group_id <= 15:
        raise ValueError("group_id must be in 1,...,15")

    cache_file = None
    if cache_dir is not None:
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / f"gap_group_24_{group_id:02d}.json"
        if cache_file.exists():
            return json.loads(cache_file.read_text(encoding="utf-8"))

    if shutil.which(gap_command) is None and not os.path.isfile(gap_command):
        raise RuntimeError(
            f'GAP executable "{gap_command}" not found. Install GAP or use --gap PATH.'
        )

    script = f'''
G := SmallGroup(24,{group_id});;
els := Elements(G);;
n := Length(els);;
Print("SIZE|",n,"\\n");
Print("ID|",Position(els,One(G)),"\\n");
for i in [1..n] do
  Print("ELT|",i,"|",String(els[i]),"\\n");
od;
for i in [1..n] do
  Print("INV|",i,"|",Position(els,Inverse(els[i])),"\\n");
od;
for i in [1..n] do
  for j in [1..n] do
    Print("MUL|",i,"|",j,"|",Position(els,els[i]*els[j]),"\\n");
  od;
od;
QUIT;
'''
    with tempfile.NamedTemporaryFile("w", suffix=".g", delete=False, encoding="utf-8") as f:
        f.write(script)
        gfile = f.name
    try:
        p = subprocess.run([gap_command, "-q", gfile], capture_output=True,
                           text=True, check=True)
    finally:
        try: os.remove(gfile)
        except OSError: pass

    size = None; identity = None
    labels = [None]*N
    inv = [None]*N
    mul = [[None]*N for _ in range(N)]

    for line in p.stdout.splitlines():
        parts = line.strip().split("|")
        if not parts: continue
        if parts[0] == "SIZE": size = int(parts[1])
        elif parts[0] == "ID": identity = int(parts[1])-1
        elif parts[0] == "ELT": labels[int(parts[1])-1] = "|".join(parts[2:])
        elif parts[0] == "INV": inv[int(parts[1])-1] = int(parts[2])-1
        elif parts[0] == "MUL":
            i,j,k = int(parts[1])-1, int(parts[2])-1, int(parts[3])-1
            mul[i][j] = k

    if size != 24 or identity is None or any(x is None for x in inv):
        raise RuntimeError("Could not parse GAP group data correctly")
    if any(x is None for row in mul for x in row):
        raise RuntimeError("Incomplete multiplication table from GAP")

    data = dict(group_id=group_id, smallgroup=[24,group_id],
                display_name=GROUP_NAMES[group_id], size=size,
                identity=identity, labels=labels, inverse=inv,
                multiplication=mul)
    if cache_file:
        cache_file.write_text(json.dumps(data, indent=2), encoding="utf-8")
    return data

# ---------------------------------------------------------------------
# Inverse blocks and adjacency rows
# ---------------------------------------------------------------------
def inverse_blocks(group):
    e = group["identity"]; inv = group["inverse"]
    seen = {e}; blocks=[]; invol=[]; pairs=[]
    for g in range(N):
        if g in seen: continue
        h = inv[g]
        if h == g:
            blocks.append((g,)); invol.append(g); seen.add(g)
        else:
            pair = tuple(sorted((g,h)))
            blocks.append(pair); pairs.append(pair); seen.update(pair)
    assert len(invol)+2*len(pairs) == 23
    return blocks, invol, pairs

def block_adjacency_rows(group, blocks):
    mul = group["multiplication"]
    out=[]
    for block in blocks:
        rows=[0]*N
        for x in range(N):
            bits=0
            for d in block:
                bits |= 1 << mul[x][d]       # edge x -> x*d
            rows[x]=bits
        out.append(rows)
    return out

def rows_from_mask(mask, block_rows):
    rows=[0]*N
    for b,br in enumerate(block_rows):
        if (mask>>b)&1:
            for i in range(N): rows[i] ^= br[i]
    return rows

def connection_set(mask, blocks):
    D=[]
    for b,B in enumerate(blocks):
        if (mask>>b)&1: D.extend(B)
    return sorted(D)

# ---------------------------------------------------------------------
# GF(2) linear algebra
# ---------------------------------------------------------------------
def gf2_basis(rows, ncols=N):
    piv=[0]*ncols
    for row in rows:
        x=row
        while x:
            p=x.bit_length()-1
            if piv[p]: x ^= piv[p]
            else:
                piv[p]=x
                break
    return [x for x in piv if x]

def gf2_rank(rows):
    return len(gf2_basis(rows))

def rref_basis(rows, ncols=N):
    piv=[0]*ncols
    for row in rows:
        x=row
        while x:
            p=x.bit_length()-1
            if piv[p]: x ^= piv[p]
            else:
                piv[p]=x
                for q in range(ncols):
                    if q != p and piv[q] and ((piv[q]>>p)&1):
                        piv[q] ^= x
                break
    for p in range(ncols):
        if not piv[p]: continue
        for q in range(ncols):
            if q != p and piv[q] and ((piv[q]>>p)&1):
                piv[q] ^= piv[p]
    return tuple(piv[p] for p in range(ncols-1,-1,-1) if piv[p])

def is_self_orthogonal(rows):
    for i in range(N):
        for j in range(i,N):
            if (rows[i] & rows[j]).bit_count() & 1:
                return False
    return True

# ---------------------------------------------------------------------
# Minimum distance
# ---------------------------------------------------------------------
def griesmer_upper_bound(n,k):
    if k==0: return 0
    ans=1
    for d in range(1,n+1):
        s=sum((d+(1<<i)-1)//(1<<i) for i in range(k))
        if s<=n: ans=d
        else: break
    return ans

def min_distance_gray(basis, stop_at=None):
    k=len(basis)
    if k==0: return 0,True
    word=0; m=N+1
    for i in range(1,1<<k):
        changed=(i & -i).bit_length()-1
        word ^= basis[changed]
        w=word.bit_count()
        if w<m:
            m=w
            if stop_at is not None and m<=stop_at:
                return m,False
            if m==1: return 1,True
    return m,True

def span_membership_structure(basis):
    piv=[0]*N
    for row in basis:
        x=row
        while x:
            p=x.bit_length()-1
            if piv[p]: x ^= piv[p]
            else:
                piv[p]=x; break
    return piv

def vector_in_span(v,piv):
    x=v
    while x:
        p=x.bit_length()-1
        if piv[p]: x ^= piv[p]
        else: return False
    return True

def min_distance_low_weight(basis, max_weight):
    piv=span_membership_structure(basis)
    for w in range(1,max_weight+1):
        for supp in combinations(range(N),w):
            v=0
            for j in supp: v |= 1<<j
            if vector_in_span(v,piv): return w
    d,_=min_distance_gray(basis)
    return d

def exact_minimum_distance(basis):
    k=len(basis)
    if k==0: return 0
    if k==N: return 1
    ub=griesmer_upper_bound(N,k)
    gray_cost=(1<<k)-1
    ambient_cost=sum(math.comb(N,w) for w in range(1,ub+1))
    if gray_cost <= ambient_cost:
        d,exact=min_distance_gray(basis)
        assert exact
        return d
    return min_distance_low_weight(basis,ub)

def can_improve(basis, incumbent):
    """Exact test of whether d(C)>incumbent."""
    if incumbent<=0: return True
    k=len(basis)
    gray_cost=(1<<k)-1
    ambient_cost=sum(math.comb(N,w) for w in range(1,incumbent+1))
    if ambient_cost < gray_cost:
        piv=span_membership_structure(basis)
        for w in range(1,incumbent+1):
            for supp in combinations(range(N),w):
                v=0
                for j in supp: v |= 1<<j
                if vector_in_span(v,piv): return False
        return True
    _,exact=min_distance_gray(basis,stop_at=incumbent)
    return exact

def selfdual_type_distance(basis):
    assert len(basis)==12
    word=0; d=N+1; typeII=True
    for i in range(1,1<<12):
        changed=(i & -i).bit_length()-1
        word ^= basis[changed]
        w=word.bit_count(); d=min(d,w)
        if w%4: typeII=False
    return ("II" if typeII else "I"),d

# ---------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------
def save_json(path,obj):
    tmp=path.with_suffix(path.suffix+".tmp")
    tmp.write_text(json.dumps(obj,indent=2,ensure_ascii=False),encoding="utf-8")
    tmp.replace(path)

def save_group_tables(out,prefix,rank_counts,best_d,best_reps,selfdual,dist_counts=None):
    with (out/f"{prefix}_rank_distribution.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f); w.writerow(["dimension_k","N_G(k)"])
        for k in range(0,25,2): w.writerow([k,rank_counts.get(k,0)])

    with (out/f"{prefix}_best_distances.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f)
        w.writerow(["dimension_k","d_G(k)","|D|","D_indices_1based","D_labels","block_mask"])
        for k in sorted(best_d):
            r=best_reps[k]
            w.writerow([k,best_d[k],len(r["D_indices_1based"]),
                        " ".join(map(str,r["D_indices_1based"])),
                        " ; ".join(r["D_labels"]),r["block_mask"]])

    with (out/f"{prefix}_selfdual.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f)
        w.writerow(["block_mask","D_indices_1based","type","distance","canonical_rowspace_hex"])
        for r in selfdual:
            w.writerow([r["block_mask"]," ".join(map(str,r["D_indices_1based"])),
                        r["type"],r["distance"]," ".join(r["canonical_rowspace_hex"])])

    if dist_counts is not None:
        with (out/f"{prefix}_distance_distribution.csv").open("w",newline="",encoding="utf-8") as f:
            w=csv.writer(f); w.writerow(["k","d","N_G(k,d)"])
            for (k,d),c in sorted(dist_counts.items()): w.writerow([k,d,c])

# ---------------------------------------------------------------------
# Main classification for one group
# ---------------------------------------------------------------------
def classify_group(group_id,gap_command,out,checkpoint_every=5000,
                   full_distance_distribution=False,force_restart=False):
    out.mkdir(parents=True,exist_ok=True)
    group=get_group_data_from_gap(group_id,gap_command,out/"gap_cache")
    labels=group["labels"]
    blocks,invol,pairs=inverse_blocks(group)
    t=len(invol); p=len(pairs); m=len(blocks); total=1<<m
    br=block_adjacency_rows(group,blocks)
    prefix=f"G{group_id:02d}"
    checkpoint=out/f"{prefix}_checkpoint.json"

    rank_counts=defaultdict(int); best_d={}; best_reps={}
    selfdual=[]; unique_sd=set(); dist_counts=defaultdict(int)
    start=0

    if checkpoint.exists() and not force_restart:
        st=json.loads(checkpoint.read_text(encoding="utf-8"))
        if bool(st.get("full_distance_distribution",False)) != bool(full_distance_distribution):
            raise RuntimeError("Checkpoint mode differs. Use same mode or --force-restart.")
        start=st["next_index"]
        rank_counts.update({int(k):v for k,v in st["rank_counts"].items()})
        best_d.update({int(k):v for k,v in st["best_d"].items()})
        best_reps.update({int(k):v for k,v in st["best_reps"].items()})
        selfdual=st.get("selfdual_records",[])
        unique_sd={tuple(r["canonical_rowspace_hex"]) for r in selfdual}
        if full_distance_distribution:
            for key,c in st.get("distance_distribution",{}).items():
                k,d=map(int,key.split(",")); dist_counts[(k,d)]=c
        print(f"Resuming from {start:,}/{total:,}")

    print("\n"+"="*78)
    print(f"{prefix} = SmallGroup(24,{group_id}) = {GROUP_NAMES[group_id]}")
    print("="*78)
    print(f"t(G)={t}, p(G)={p}, N(G)=2^{m}={total:,}")
    print("involutions (GAP element positions, 1-based):",[x+1 for x in invol])
    print("inverse pairs:",[(a+1,b+1) for a,b in pairs])

    if start < total:
        gray=start^(start>>1)
        rows=rows_from_mask(gray,br)
        tic=time.time()

        for idx in range(start,total):
            k=gf2_rank(rows)
            rank_counts[k]+=1
            basis=None

            if k>0:
                basis=gf2_basis(rows)
                if full_distance_distribution:
                    d=exact_minimum_distance(basis)
                    dist_counts[(k,d)]+=1
                    if d>best_d.get(k,0):
                        best_d[k]=d
                        D=connection_set(gray,blocks)
                        best_reps[k]={"block_mask":gray,
                                      "D_indices_1based":[x+1 for x in D],
                                      "D_labels":[labels[x] for x in D]}
                        print(f"NEW BEST  [24,{k},{d}]  idx={idx:,}  |D|={len(D)}")
                else:
                    incumbent=best_d.get(k,0)
                    ub=griesmer_upper_bound(N,k)
                    if incumbent < ub and can_improve(basis,incumbent):
                        d=exact_minimum_distance(basis)
                        if d>incumbent:
                            best_d[k]=d
                            D=connection_set(gray,blocks)
                            best_reps[k]={"block_mask":gray,
                                          "D_indices_1based":[x+1 for x in D],
                                          "D_labels":[labels[x] for x in D]}
                            print(f"NEW BEST  [24,{k},{d}]  idx={idx:,}  |D|={len(D)}")

            if k==12 and is_self_orthogonal(rows):
                if basis is None: basis=gf2_basis(rows)
                typ,sd_d=selfdual_type_distance(basis)
                canon=tuple(f"{x:06x}" for x in rref_basis(rows))
                D=connection_set(gray,blocks)
                rec={"block_mask":gray,"D_indices_1based":[x+1 for x in D],
                     "D_labels":[labels[x] for x in D],"type":typ,"distance":sd_d,
                     "canonical_rowspace_hex":list(canon)}
                selfdual.append(rec); unique_sd.add(canon)

            nxt=idx+1
            if nxt%checkpoint_every==0 or nxt==total:
                dt=time.time()-tic; rate=(nxt-start)/dt if dt else 0
                print(f"progress {nxt:,}/{total:,} ({100*nxt/total:6.2f}%), "
                      f"rate={rate:,.1f}/s, self-dual cases={len(selfdual):,}")
                state={"group_id":group_id,"next_index":nxt,"t":t,"p":p,"N_G":total,
                       "rank_counts":{str(k):v for k,v in rank_counts.items()},
                       "best_d":{str(k):v for k,v in best_d.items()},
                       "best_reps":{str(k):v for k,v in best_reps.items()},
                       "selfdual_records":selfdual,
                       "full_distance_distribution":full_distance_distribution,
                       "distance_distribution":{f"{k},{d}":c for (k,d),c in dist_counts.items()}}
                save_json(checkpoint,state)

            if nxt<total:
                next_gray=nxt^(nxt>>1); diff=gray^next_gray
                b=diff.bit_length()-1
                for r in range(N): rows[r] ^= br[b][r]
                gray=next_gray

    save_group_tables(out,prefix,rank_counts,best_d,best_reps,selfdual,
                      dist_counts if full_distance_distribution else None)

    assert sum(rank_counts.values())==total
    assert not [k for k,c in rank_counts.items() if c and k%2]

    result={
        "group_id":group_id,"smallgroup":[24,group_id],"display_name":GROUP_NAMES[group_id],
        "t":t,"p":p,"N_G":total,
        "rank_counts":dict(sorted(rank_counts.items())),
        "best_d":dict(sorted(best_d.items())),
        "best_representatives":best_reps,
        "selfdual_connection_sets":len(selfdual),
        "selfdual_distinct_rowspaces":len(unique_sd),
        "type_I_connection_sets":sum(r["type"]=="I" for r in selfdual),
        "type_II_connection_sets":sum(r["type"]=="II" for r in selfdual),
        "best_selfdual_distance":max((r["distance"] for r in selfdual),default=None)
    }
    save_json(out/f"{prefix}_summary.json",result)

    print("\nRANK DISTRIBUTION")
    for k in range(0,25,2): print(f"k={k:2d}: {rank_counts.get(k,0):,}")
    print("\nBEST DISTANCES")
    for k in sorted(best_d): print(f"[24,{k},{best_d[k]}]")
    print("\nSELF-DUAL")
    print("connection sets:",len(selfdual))
    print("distinct row spaces:",len(unique_sd))
    print("Type I:",sum(r["type"]=="I" for r in selfdual))
    print("Type II:",sum(r["type"]=="II" for r in selfdual))
    print("best self-dual d:",result["best_selfdual_distance"])
    return result

# ---------------------------------------------------------------------
# Combined tables for the paper
# ---------------------------------------------------------------------
def build_master_tables(out):
    summaries=[]
    for gid in range(1,16):
        f=out/f"G{gid:02d}_summary.json"
        if f.exists(): summaries.append(json.loads(f.read_text(encoding="utf-8")))
    if not summaries: return

    dims_rank=list(range(0,25,2)); dims_d=list(range(2,25,2))

    with (out/"ALL_GROUPS_structural_summary.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f); w.writerow(["G_i","SmallGroup_ID","structure","t(G)","p(G)","N(G)",
            "selfdual_connection_sets","selfdual_distinct_rowspaces","Type_I","Type_II","best_selfdual_d"])
        for s in summaries:
            i=s["group_id"]
            w.writerow([f"G_{i}",f"SmallGroup(24,{i})",s["display_name"],s["t"],s["p"],s["N_G"],
                        s["selfdual_connection_sets"],s["selfdual_distinct_rowspaces"],
                        s["type_I_connection_sets"],s["type_II_connection_sets"],s["best_selfdual_distance"]])

    with (out/"ALL_GROUPS_rank_distribution.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f); w.writerow(["G_i","structure"]+[f"k={k}" for k in dims_rank])
        for s in summaries:
            rc={int(k):v for k,v in s["rank_counts"].items()}
            w.writerow([f"G_{s['group_id']}",s["display_name"]]+[rc.get(k,0) for k in dims_rank])

    with (out/"ALL_GROUPS_best_distances.csv").open("w",newline="",encoding="utf-8") as f:
        w=csv.writer(f); w.writerow(["G_i","structure"]+[f"k={k}" for k in dims_d])
        for s in summaries:
            bd={int(k):v for k,v in s["best_d"].items()}
            w.writerow([f"G_{s['group_id']}",s["display_name"]]+[bd.get(k,"") for k in dims_d])

    print("Updated combined CSV tables for the manuscript.")

