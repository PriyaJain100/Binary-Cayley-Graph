GROUP_NUMBER = 12
RUN_ALL = False

# GAP must be installed and callable as "gap".
GAP_COMMAND = "gap"

OUTPUT_DIRECTORY = "cayley_order24_results"
CHECKPOINT_EVERY = 5000

# False is recommended for the paper tables d_G(k).
# True computes the complete N_G(k,d) distribution for every D and is slower.
FULL_DISTANCE_DISTRIBUTION = False

# Set True only when you deliberately want to discard an existing checkpoint.
FORCE_RESTART = False


def run_notebook():
    """Run the selected group(s) from Jupyter/Colab without argparse."""
    if not RUN_ALL and not (1 <= int(GROUP_NUMBER) <= 15):
        raise ValueError("GROUP_NUMBER must be an integer from 1 to 15.")

    # Give a concise, notebook-friendly error before starting the long search.
    if shutil.which(GAP_COMMAND) is None and not os.path.isfile(GAP_COMMAND):
        raise RuntimeError(
            'GAP was not found. This program uses GAP only to obtain '
            'SmallGroup(24,i). In Google Colab, run this once in a separate cell:\n\n'
            '    !apt-get -qq update\n'
            '    !apt-get -qq install -y gap\n\n'
            'Then rerun this program.'
        )

    out = Path(OUTPUT_DIRECTORY)
    gids = list(range(1, 16)) if RUN_ALL else [int(GROUP_NUMBER)]

    print("Selected group(s):", gids)
    print("Output directory :", out)
    print("GAP executable   :", GAP_COMMAND)

    results = []
    for gid in gids:
        result = classify_group(
            gid,
            GAP_COMMAND,
            out,
            CHECKPOINT_EVERY,
            FULL_DISTANCE_DISTRIBUTION,
            FORCE_RESTART,
        )
        results.append(result)
        build_master_tables(out)

    print("\nAll requested computations finished.")
    return results


# In a notebook, executing the cell runs the settings above directly.
results = run_notebook()
